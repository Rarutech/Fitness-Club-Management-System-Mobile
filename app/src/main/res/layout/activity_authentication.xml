<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Authentication">

    <!-- Logo -->
    <ImageView
        android:id="@+id/imageAuthenLogo"
        android:layout_width="200dp"
        android:layout_height="210dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.04"
        app:srcCompat="@drawable/welcome_page_logo"
        android:contentDescription="WelcomePageLogo"/>

    <!-- Caption -->
    <TextView
        android:id="@+id/tvAuthenCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_regular"
        android:gravity="center_horizontal"
        android:lineSpacingExtra="5dp"
        android:padding="16dp"
        android:text="Don’t Wait – Your Fitness Goals Are Just a Click Away!"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.354" />

    <!-- Login Button -->
    <Button
        android:id="@+id/btnAuthenLogin"
        android:layout_width="320dp"
        android:layout_height="55dp"
        android:background="@drawable/blue_button"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:text="Login"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.757" />

    <!-- Sign up Button -->

    <!--Material Button for different button appearance-->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAuthenSignUp"
        style="@style/CustomBlueButtonStyle"
        android:layout_width="320dp"
        android:layout_height="55dp"
        android:fontFamily="@font/inter_regular"
        android:text="Sign Up"
        android:textAllCaps="false"
        android:textColor="#007BFF"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.869" />

</androidx.constraintlayout.widget.ConstraintLayout>