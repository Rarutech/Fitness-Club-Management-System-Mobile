<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".BookTrainerSuccess">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        app:layout_constraintVertical_bias="0.0"
        app:navigationIcon="@drawable/back_btn"
        app:title="Book Session"
        app:titleMarginStart="15dp"
        app:titleTextAppearance="@style/CustomToolbarTitle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Appointment Confirmation Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:textSize="20sp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="16dp"
                android:text="Appointment Confirmed!" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your session has been scheduled. Please wait for the trainer's approval. Kindly arrive on time."
                android:fontFamily="@font/open_sans"
                android:textSize="16sp"
                android:textStyle="italic"
                android:layout_marginTop="5dp"
                android:layout_marginStart="13dp"/>

            <!-- Appointment Details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/poppins_medium"
                android:textSize="20sp"
                android:layout_marginStart="16dp"
                android:text="Appointment Details"/>

            <FrameLayout
                android:layout_width="330dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/black_rectangle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/ivProfile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="John Doe"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/inter_regular" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fitness Trainer"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="16sp"
                            android:layout_marginStart="5dp"
                            android:textColor="#808080"/>

                        <TextView
                            android:id="@+id/tvRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ 4.5"
                            android:layout_marginTop="8dp"
                            android:layout_marginStart="5dp"
                            android:textSize="15sp" />
                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/poppins_medium"
                android:textSize="20sp"
                android:layout_marginStart="16dp"
                android:text="Date"/>

            <TextView
                android:id="@+id/tvDate"
                android:background="@drawable/black_rectangle"
                android:layout_width="330dp"
                android:layout_gravity="center"
                android:layout_height="50dp"
                android:fontFamily="@font/open_sans"
                android:drawableStart="@drawable/calendarr"
                android:drawablePadding="25dp"
                android:padding="14.5dp"
                android:text="March 15, 2022"
                android:textSize="16sp"/>

            <!-- Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/poppins_medium"
                android:textSize="20sp"
                android:layout_marginStart="16dp"
                android:text="Time"/>

            <TextView
                android:id="@+id/tvTime"
                android:background="@drawable/black_rectangle"
                android:layout_width="330dp"
                android:layout_gravity="center"
                android:layout_height="50dp"
                android:fontFamily="@font/open_sans"
                android:drawableStart="@drawable/clock"
                android:padding="14.5dp"
                android:drawablePadding="25dp"
                android:text="12:00 - 1:00"
                android:textSize="16sp"/>

            <!-- Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/poppins_medium"
                android:textSize="20sp"
                android:layout_marginStart="16dp"
                android:text="Location"/>
            <TextView
                android:background="@drawable/black_rectangle"
                android:layout_width="330dp"
                android:padding="9dp"
                android:layout_gravity="center"
                android:layout_height="60dp"
                android:fontFamily="@font/open_sans"
                android:text="3rd floor Espino Bldg. Burgos st. Dagupan City, Dagupan City, Philippines"
                android:textSize="16sp"/>

            <!-- Workout Program -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/poppins_medium"
                android:textSize="20sp"
                android:layout_marginStart="16dp"
                android:text="Workout Program"/>

            <TextView
                android:id="@+id/tvDescription"
                android:background="@drawable/black_rectangle"
                android:layout_width="330dp"
                android:padding="14dp"
                android:layout_gravity="center"
                android:layout_height="50dp"
                android:fontFamily="@font/open_sans"
                android:text="Weight Loss"
                android:textSize="16sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
