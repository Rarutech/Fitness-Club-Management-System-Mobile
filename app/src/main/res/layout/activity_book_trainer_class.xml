<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".BookTrainerClass">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        app:layout_constraintVertical_bias="0.0"
        app:navigationIcon="@drawable/back_btn"
        app:title="Book Session"
        app:titleMarginStart="15dp"
        app:titleTextAppearance="@style/CustomToolbarTitle" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/black_rectangle">

                <!-- Profile Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivProfile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <!-- Profile Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="3dp">

                        <!-- Name -->
                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="John Doe"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/inter_regular" />

                        <!-- Specialization -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fitness Trainer"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="16sp"
                            android:layout_marginStart="5dp"
                            android:textColor="#808080" />

                        <!-- Rating -->
                        <TextView
                            android:id="@+id/tvRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⭐ 4.5"
                            android:layout_marginTop="30dp"
                            android:layout_marginStart="5dp"
                            android:textSize="15sp"  />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            </FrameLayout>

            <!-- Workout Program -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workout Program"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/poppins_medium"
                android:textSize="20sp"
                android:layout_marginStart="16dp" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="320dp"
                android:layout_height="65sp"
                android:layout_gravity="center"
                android:background="@drawable/edittext_border"
                android:hint="eg, Weight Loss,"
                android:fontFamily="@font/poppins_medium"
                android:paddingLeft="16dp"
                android:paddingTop="6dp"
                android:textColorHint="#B0B0B0"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/poppins_medium"
                android:textSize="20sp"
                android:layout_marginStart="16dp"
                android:text="Date" />

            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="370dp"
                android:layout_height="300dp"
                android:layout_gravity="center"/>

            <!-- Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/poppins_medium"
                android:textSize="20sp"
                android:layout_marginStart="16dp"
                android:text="Time" />

            <!-- Start and End Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="15dp">

                <TextView
                    android:id="@+id/selectedStartTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:text="Start Time: "
                    android:textSize="18sp"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/selectedEndTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:text="End Time: "
                    android:textSize="18sp"
                    android:fontFamily="@font/open_sans"
                    android:textColor="@color/black"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Start Time Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectStartTimeButton"
                    android:layout_width="160dp"
                    android:layout_height="60dp"
                    style="@style/CustomBlueButtonStyle"
                    android:text="Select Start Time"
                    android:textAllCaps="false"
                    android:textColor="#007BFF"
                    android:textSize="16sp"/>

                <!-- End Time Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectEndTimeButton"
                    android:layout_width="160dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="8dp"
                    style="@style/CustomBlueButtonStyle"
                    android:text="Select End Time"
                    android:layout_marginEnd="16dp"
                    android:textAllCaps="false"
                    android:textColor="#007BFF"
                    android:textSize="16sp"/>
            </LinearLayout>

            <!-- Confirm Button -->
            <Button
                android:id="@+id/btnBookClass"
                android:layout_width="320dp"
                android:layout_height="55dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20sp"
                android:layout_marginBottom="44dp"
                android:background="@drawable/blue_button"
                android:fontFamily="@font/inter_regular"
                android:text="Confirm"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
