<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".AddExercise">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAddExercise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        app:navigationIcon="@drawable/back_btn"
        app:title="Add Exercise"
        android:background="@color/white"
        android:elevation="4dp"
        app:titleTextAppearance="@style/CustomToolbarTitle"
        app:titleMarginStart="15dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Search Button -->
    <ImageButton
        android:id="@+id/btnSearch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@null"
        android:contentDescription="Search"
        android:src="@drawable/search"
        android:elevation="5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0" />

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbarAddExercise"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Parent Linear Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- First Row -->

            <!-- First Rectangle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Frame Layout to stack views on top of each other -->
                <FrameLayout
                    android:layout_width="165dp"
                    android:layout_height="210dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bgrectangle"
                        android:scaleType="centerCrop"
                        android:contentDescription="Exercise 1"/>

                    <ImageButton
                        android:id="@+id/imgBtnDumbbFlyes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/dumbbell_flyes"
                        android:contentDescription="Pull-ups"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Dumbbell Flyes"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="150dp"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chest"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp"
                        android:layout_marginTop="175dp"
                        android:layout_marginStart="5dp"
                        android:textColor="#808080"/>
                </FrameLayout>

                <!-- Second Rectangle -->

                <!-- Frame Layout to stack views on top of each other -->
                <FrameLayout
                    android:layout_width="165dp"
                    android:layout_height="210dp"
                    android:layout_marginStart="20dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bgrectangle"
                        android:scaleType="centerCrop"
                        android:contentDescription="Exercise 2"/>

                    <ImageButton
                        android:id="@+id/imgBtnBenchPress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/bench_press"
                        android:contentDescription="Bench Pree"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Bench Press"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="150dp"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chest"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp"
                        android:layout_marginTop="175dp"
                        android:layout_marginStart="5dp"
                        android:textColor="#808080"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Second Row -->

            <!-- Third Rectangle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:padding="16dp">

                <!-- Frame Layout to stack views on top of each other -->
                <FrameLayout
                    android:layout_width="165dp"
                    android:layout_height="210dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bgrectangle"
                        android:scaleType="centerCrop"
                        android:contentDescription="Exercise 3"/>

                    <ImageButton
                        android:id="@+id/imgBtnPullUps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="30dp"
                        android:src="@drawable/pull_ups"
                        android:contentDescription="Pull-ups"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Pull-ups"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="150dp"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Back"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp"
                        android:layout_marginTop="175dp"
                        android:layout_marginStart="5dp"
                        android:textColor="#808080"/>
                </FrameLayout>

                <!-- Fourth Rectangle -->

                <!-- Frame Layout to stack views on top of each other -->
                <FrameLayout
                    android:layout_width="165dp"
                    android:layout_height="210dp"
                    android:layout_marginStart="20dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bgrectangle"
                        android:scaleType="centerCrop"
                        android:contentDescription="Exercise 4"/>

                    <ImageButton
                        android:id="@+id/imgBtnDeadlift"
                        android:contentDescription="Deadlift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/deadlift"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Deadlift"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="150dp"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Back"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp"
                        android:layout_marginTop="175dp"
                        android:layout_marginStart="5dp"
                        android:textColor="#808080"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Third Row -->

            <!-- Fifth Rectangle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:padding="16dp">

                <!-- Frame Layout to stack views on top of each other -->
                <FrameLayout
                    android:layout_width="165dp"
                    android:layout_height="210dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bgrectangle"
                        android:scaleType="centerCrop"
                        android:contentDescription="Exercise 5"/>

                    <ImageButton
                        android:id="@+id/imgBtnTricepDips"
                        android:contentDescription="Tricep DIps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/tricep_dips"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Tricep Dips"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="150dp"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arms"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp"
                        android:layout_marginTop="175dp"
                        android:layout_marginStart="5dp"
                        android:textColor="#808080"/>
                </FrameLayout>

                <!-- Sixth Rectangle -->

                <!-- Frame Layout to stack views on top of each other -->
                <FrameLayout
                    android:layout_width="165dp"
                    android:layout_height="210dp"
                    android:layout_marginStart="20dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bgrectangle"
                        android:scaleType="centerCrop"
                        android:contentDescription="Exercise 6"/>

                    <ImageButton
                        android:id="@+id/imgBtnHammerCurls"
                        android:contentDescription="Hammer Curls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/hammer_curls"
                        android:layout_marginStart="30dp"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Hammer Curls"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="150dp"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arms"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp"
                        android:layout_marginTop="175dp"
                        android:layout_marginStart="5dp"
                        android:textColor="#808080"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Fourth Row -->

            <!-- Seventh Rectangle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="165dp"
                    android:layout_height="210dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bgrectangle"
                        android:scaleType="centerCrop"
                        android:contentDescription="Exercise 7"/>

                    <ImageButton
                        android:id="@+id/imgBtnRussianTwist"
                        android:contentDescription="Russian Twist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="30dp"
                        android:src="@drawable/russian_twist"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Russian Twist"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="150dp"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Abs"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp"
                        android:layout_marginTop="175dp"
                        android:layout_marginStart="5dp"
                        android:textColor="#808080"/>
                </FrameLayout>

                <!-- Eight Rectangle -->
                <FrameLayout
                    android:layout_width="165dp"
                    android:layout_height="210dp"
                    android:layout_marginStart="20dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bgrectangle"
                        android:scaleType="centerCrop"
                        android:contentDescription="Exercise 6"/>

                    <ImageButton
                        android:id="@+id/imgBtnLegPress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/leg_press"
                        android:layout_marginStart="3dp"
                        android:background="@android:color/transparent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Hammer Curls"
                        android:layout_marginStart="5dp"
                        android:layout_marginTop="150dp"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Arms"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="14sp"
                        android:layout_marginTop="175dp"
                        android:layout_marginStart="5dp"
                        android:textColor="#808080"/>

                </FrameLayout>
            </LinearLayout>

            <!-- Add Exercise Button -->
            <Button
                android:layout_width="350dp"
                android:layout_height="66dp"
                android:background="@drawable/blue_button"
                android:fontFamily="@font/inter_regular"
                android:text="Add Exercise"
                android:layout_marginTop="30dp"
                android:textSize="16sp"
                android:layout_gravity="center"/>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
