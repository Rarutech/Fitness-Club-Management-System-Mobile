<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ProductDetailsActivity">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarBuyProducts"
        android:layout_width="411dp"
        android:layout_height="?attr/actionBarSize"
        android:paddingTop="5dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:title="Checkout"
        app:titleMarginStart="15dp"
        android:background="@color/white"
        android:elevation="4dp"
        app:titleTextAppearance="@style/CustomToolbarTitle"
        app:navigationIcon="@drawable/back_btn" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_marginTop="?attr/actionBarSize">

        <LinearLayout
            android:layout_margin="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Product Image -->
            <ImageView
                android:id="@+id/productImage"
                android:layout_width="350dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:contentDescription="Product Image"/>

            <!-- Product Name -->
            <TextView
                android:id="@+id/productName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textSize="23sp"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginTop="20dp"/>

            <!-- Product Price -->
            <TextView
                android:id="@+id/productPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_regular"
                android:textStyle="bold"
                android:layout_marginTop="10dp"/>

            <!-- Product Stock -->
            <TextView
                android:id="@+id/productStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock"
                android:textSize="16sp"
                android:textStyle="italic"
                android:fontFamily="@font/inter_regular"
                android:layout_marginTop="5dp"/>

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="*This item is available for pickup only. Please visit our gym after placing your order."
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:textStyle="bold"
                android:layout_marginTop="10dp"/>

            <!-- Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pumping Iron Fitness Gym"
                android:fontFamily="@font/inter_regular"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp"/>

            <!-- Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3rd floor Espino Bldg. Burgos st. Dagupan City, Dagupan City, Philippines"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="#808080"
                android:layout_marginTop="10dp"/>

            <!-- Quantity -->
            <EditText
                android:id="@+id/etQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Quantity"
                android:inputType="number"
                android:textSize="16sp"
                android:layout_marginTop="10dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Place Order Button -->
            <Button
                android:id="@+id/btnPurchase"
                android:layout_width="350dp"
                android:layout_height="66dp"
                android:text="Place Order for Pickup"
                android:textSize="16sp"
                android:fontFamily="@font/inter_regular"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/blue_button"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>