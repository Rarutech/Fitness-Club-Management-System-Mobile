<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomGrayButtonStyle" parent="Widget.MaterialComponents.Button">

        <!-- To set your custom drawable as the background -->
        <item name="android:background">@drawable/gray_button</item>

        <!-- Remove any tint so that the drawable appears as-is -->
        <item name="backgroundTint">@null</item>

        <!-- To remove elevation and state animations (shadow) -->
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
